---
import { formatDate } from '../helpers/format';

interface Props {
  title: string;
  date: Date;
  shortDescription: string;
  categories: string[];
  url: string;
  duration?: string;
  // Set for a course: shown in place of the duration.
  lessons?: number;
}

const { title, date, shortDescription, categories, url, duration, lessons } = Astro.props;
---

<article class="Entry Entry--lab">
  <div class="Entry-duration">
    {lessons ? (
      <span class="Entry-lessons">{lessons}<small>lessons</small></span>
    ) : (
      duration && <span aria-label={`Takes about ${duration}`}>{duration}</span>
    )}
  </div>
  <div>
    <h2 class="Entry-title"><a href={url}>{title}</a></h2>
    <p class="Entry-summary">{shortDescription}</p>
    <div class="Entry-meta">
      <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
      <span class="Entry-tags">{categories.map((cat) => <span class="Tag Tag--static">{cat}</span>)}</span>
    </div>
  </div>
</article>
