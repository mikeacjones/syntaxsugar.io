---
// Client behavior for course pages: language tabs for the build steps, and
// "Check it" checklists that remember their ticks and mark finished lessons
// in the sidebar. Progress lives in this browser only.
---

<script is:inline>
  (function () {
    var nav = document.querySelector('.CourseNav');
    if (!nav) return;
    var course = nav.getAttribute('data-course');
    var LANG_KEY = 'course:lang';

    // On narrow screens the nav is a scrolling row; bring the current lesson into view.
    var active = nav.querySelector('.active');
    if (active && nav.scrollWidth > nav.clientWidth) nav.scrollLeft = active.offsetLeft - 16;
    var TICKS_KEY = 'course:' + course + ':ticks';

    function load(key, fallback) {
      try {
        var value = JSON.parse(localStorage.getItem(key));
        return value == null ? fallback : value;
      } catch (e) {
        return fallback;
      }
    }

    function save(key, value) {
      try {
        localStorage.setItem(key, JSON.stringify(value));
      } catch (e) {}
    }

    // Language tabs: each run of adjacent .CourseLang panels gets one tab bar.
    var panels = Array.prototype.slice.call(document.querySelectorAll('.CourseLang'));
    var groups = [];
    panels.forEach(function (panel) {
      var group = groups[groups.length - 1];
      if (group && group[group.length - 1].nextElementSibling === panel) group.push(panel);
      else groups.push([panel]);
    });

    var tabBars = [];
    function selectLang(lang) {
      tabBars.forEach(function (bar) {
        var group = bar.group;
        var match = group.some(function (p) { return p.dataset.lang === lang; }) ? lang : group[0].dataset.lang;
        group.forEach(function (p) { p.hidden = p.dataset.lang !== match; });
        bar.querySelectorAll('button').forEach(function (b) {
          b.setAttribute('aria-selected', String(b.dataset.lang === match));
          b.tabIndex = b.dataset.lang === match ? 0 : -1;
        });
      });
    }

    groups.forEach(function (group, g) {
      var bar = document.createElement('div');
      bar.className = 'CourseLang-tabs';
      bar.setAttribute('role', 'tablist');
      bar.setAttribute('aria-label', 'Language');
      bar.group = group;
      group.forEach(function (panel, i) {
        var id = 'lang-' + g + '-' + panel.dataset.lang;
        var button = document.createElement('button');
        button.type = 'button';
        button.setAttribute('role', 'tab');
        button.id = id + '-tab';
        button.setAttribute('aria-controls', id);
        button.dataset.lang = panel.dataset.lang;
        button.textContent = panel.dataset.label;
        button.addEventListener('click', function () {
          save(LANG_KEY, panel.dataset.lang);
          selectLang(panel.dataset.lang);
        });
        bar.appendChild(button);
        panel.id = id;
        panel.setAttribute('role', 'tabpanel');
        panel.setAttribute('aria-labelledby', id + '-tab');
      });
      bar.addEventListener('keydown', function (e) {
        if (e.key !== 'ArrowRight' && e.key !== 'ArrowLeft') return;
        var buttons = Array.prototype.slice.call(bar.querySelectorAll('button'));
        var i = buttons.indexOf(document.activeElement);
        var next = buttons[(i + (e.key === 'ArrowRight' ? 1 : buttons.length - 1)) % buttons.length];
        next.focus();
        next.click();
      });
      group[0].before(bar);
      tabBars.push(bar);
    });
    if (tabBars.length) selectLang(load(LANG_KEY, null));

    // Checklists. Ticks are stored per lesson as an array of booleans.
    var lesson = document.querySelector('[data-course-lesson]');
    var ticks = load(TICKS_KEY, {});

    function markNav() {
      nav.querySelectorAll('[data-lesson]').forEach(function (link) {
        var saved = ticks[link.dataset.lesson];
        var done = saved && saved.total > 0 && saved.done === saved.total;
        link.classList.toggle('done', !!done);
      });
    }

    if (lesson) {
      var slug = lesson.getAttribute('data-course-lesson');
      var boxes = Array.prototype.slice.call(lesson.querySelectorAll('input[type=checkbox]'));
      var saved = (ticks[slug] && ticks[slug].boxes) || [];
      var update = function () {
        var state = boxes.map(function (b) { return b.checked; });
        ticks[slug] = { boxes: state, done: state.filter(Boolean).length, total: state.length };
        save(TICKS_KEY, ticks);
        markNav();
      };
      boxes.forEach(function (box, i) {
        box.disabled = false;
        box.checked = !!saved[i];
        var item = box.closest('li');
        if (item) item.classList.toggle('checked', box.checked);
        box.addEventListener('change', function () {
          if (item) item.classList.toggle('checked', box.checked);
          update();
        });
      });
      if (boxes.length && !ticks[slug]) update();
    }
    markNav();
  })();
</script>
