---
import { tagSlug } from '../helpers/format';

interface Props {
  tag: string;
  active?: boolean;
  href?: string;
}

const { tag, active = false, href } = Astro.props;
const chipHref = href ?? `/tag/${tagSlug(tag)}`;
---

<a class:list={['Tag', { active }]} href={chipHref} aria-current={active ? 'page' : undefined}>{tag}</a>
