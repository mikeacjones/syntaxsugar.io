---
import Chip from './Chip.astro';
import { formatDate } from '../helpers/format';

interface Props {
  title: string;
  date: Date;
  shortDescription: string;
  tags: string[];
  url: string;
  featured?: boolean;
}

const { title, date, shortDescription, tags, url, featured = false } = Astro.props;
---

<article class:list={['Entry', { 'Entry--featured': featured }]}>
  <h2 class="Entry-title"><a href={url}>{title}</a></h2>
  <p class="Entry-summary">{shortDescription}</p>
  <div class="Entry-meta">
    <time datetime={date.toISOString().slice(0, 10)}>{formatDate(date)}</time>
    <span class="Entry-tags">{tags.map((tag) => <Chip tag={tag} />)}</span>
  </div>
</article>
