---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableImage from '../../components/ZoomableImage.astro';
import Mermaid from '../../components/Mermaid.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const posts = await getCollection('blog');
  return posts.map((post) => {
    // post.id is like "2023/bola/index" or "2020/getting-started-with-dw/index"
    const slug = post.id.replace(/\/index$/, '');
    return {
      params: { slug },
      props: { post },
    };
  });
}

const { post } = Astro.props;
const { Content } = await render(post);

---

<BaseLayout title={post.data.title} description={post.data.shortDescription}>
  <div class="post-view">
    <ArticleHeader title={post.data.title} date={post.data.date} tags={post.data.tags} />
    <div class="post-view-content">
      <Content />
    </div>
  </div>
  <CodeBlock />
  <ZoomableImage />
  <Mermaid />
</BaseLayout>
