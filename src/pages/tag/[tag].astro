---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PostCard from '../../components/PostCard.astro';
import Chip from '../../components/Chip.astro';
import { getCollection } from 'astro:content';
import { postUrl, tagSlug } from '../../helpers/format';

export async function getStaticPaths() {
  const allPosts = await getCollection('blog', ({ data }) => data.published === true);
  const tags = [...new Set(allPosts.flatMap((post) => post.data.tags))].sort();

  return tags.map((tag) => ({
    params: { tag: tagSlug(tag) },
    props: { tag, allTags: tags },
  }));
}

const { tag, allTags } = Astro.props;

const posts = await getCollection('blog', ({ data }) => data.published === true && data.tags.includes(tag));
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<BaseLayout title={`Posts tagged ${tag}`}>
  <header class="PageHeader">
    <h1>{tag}</h1>
    <p>{posts.length === 1 ? '1 post' : `${posts.length} posts`} with this tag. <a href="/">See all writing</a></p>
  </header>

  <div class="Year-entries">
    {posts.map((post) => (
      <PostCard
        title={post.data.title}
        date={post.data.date}
        shortDescription={post.data.shortDescription}
        tags={post.data.tags}
        url={postUrl(post.id)}
      />
    ))}
  </div>

  <nav class="TagCloud" aria-label="All tags">
    <h2>Other tags</h2>
    <div>{allTags.map((t: string) => <Chip tag={t} active={t === tag} />)}</div>
  </nav>
</BaseLayout>
