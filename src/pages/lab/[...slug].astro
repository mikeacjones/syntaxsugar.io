---
import BaseLayout from '../../layouts/BaseLayout.astro';
import ArticleHeader from '../../components/ArticleHeader.astro';
import { isoDuration } from '../../helpers/format';
import CodeBlock from '../../components/CodeBlock.astro';
import ZoomableImage from '../../components/ZoomableImage.astro';
import Mermaid from '../../components/Mermaid.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const labs = await getCollection('labs');
  return labs.map((lab) => {
    const slug = lab.id.replace(/\/index$/, '');
    return {
      params: { slug },
      props: { lab },
    };
  });
}

const { lab } = Astro.props;
const { Content } = await render(lab);

---

<BaseLayout
  title={lab.data.title}
  description={lab.data.shortDescription}
  article={{
    date: lab.data.date,
    tags: lab.data.categories,
    type: ['TechArticle', 'LearningResource'],
    schema: { learningResourceType: 'Lab', timeRequired: isoDuration(lab.data.duration) },
  }}
  breadcrumbs={[{ name: 'Labs', url: '/labs' }]}
  hasMarkdown={lab.data.published}
>
  <div class="post-view">
    <ArticleHeader
      title={lab.data.title}
      date={lab.data.date}
      duration={lab.data.duration}
      tags={lab.data.categories}
      linkTags={false}
    />

    <div class="codelab-wrapper">
      <nav class="codelab-steps-nav" id="lab-steps-nav"></nav>
      <div class="codelab-content" id="lab-content">
        <div class="post-view-content" id="lab-raw-content">
          <Content />
        </div>
      </div>
    </div>
  </div>
  <CodeBlock />
  <ZoomableImage />
  <Mermaid />
</BaseLayout>

<script is:inline>
  (function() {
    var rawContent = document.getElementById('lab-raw-content');
    var labContent = document.getElementById('lab-content');
    var nav = document.getElementById('lab-steps-nav');
    if (!rawContent || !labContent || !nav) return;

    var children = Array.from(rawContent.children);
    var steps = [];
    var currentStep = null;

    for (var i = 0; i < children.length; i++) {
      var el = children[i];
      if (el.tagName === 'H2') {
        if (currentStep) steps.push(currentStep);
        currentStep = { title: el.textContent, elements: [] };
      } else if (currentStep) {
        currentStep.elements.push(el);
      } else {
        if (!currentStep) {
          currentStep = { title: 'Overview', elements: [] };
        }
        currentStep.elements.push(el);
      }
    }
    if (currentStep) steps.push(currentStep);
    if (steps.length === 0) return;

    rawContent.remove();
    var sections = [];

    for (var s = 0; s < steps.length; s++) {
      var step = steps[s];

      var btn = document.createElement('button');
      btn.className = 'codelab-step-link' + (s === 0 ? ' active' : '');
      btn.setAttribute('data-step', s);
      btn.innerHTML = '<span class="codelab-step-number">' + (s + 1) + '</span>' +
        '<span class="codelab-step-label">' + step.title + '</span>';
      nav.appendChild(btn);

      var section = document.createElement('section');
      section.className = 'codelab-step' + (s === 0 ? ' active' : '');
      section.id = 'lab-step-' + (s + 1);

      var topNav = document.createElement('div');
      topNav.className = 'codelab-step-nav codelab-step-nav-top';
      if (s > 0) {
        var prevTop = document.createElement('button');
        prevTop.className = 'codelab-nav-btn codelab-prev';
        prevTop.setAttribute('data-target', s - 1);
        prevTop.innerHTML = '&larr; Previous';
        topNav.appendChild(prevTop);
      }
      if (s < steps.length - 1) {
        var nextTop = document.createElement('button');
        nextTop.className = 'codelab-nav-btn codelab-next';
        nextTop.setAttribute('data-target', s + 1);
        nextTop.innerHTML = 'Next &rarr;';
        topNav.appendChild(nextTop);
      } else {
        var doneTop = document.createElement('a');
        doneTop.className = 'codelab-nav-btn codelab-next';
        doneTop.href = '/labs';
        doneTop.innerHTML = 'Done &check;';
        topNav.appendChild(doneTop);
      }
      section.appendChild(topNav);

      var title = document.createElement('h2');
      title.className = 'codelab-step-title';
      title.innerHTML = '<span class="codelab-step-badge">' + (s + 1) + ' / ' + steps.length + '</span> ' + step.title;
      section.appendChild(title);

      var content = document.createElement('div');
      content.className = 'codelab-step-content post-view-content';
      for (var e = 0; e < step.elements.length; e++) {
        content.appendChild(step.elements[e]);
      }
      section.appendChild(content);

      var botNav = document.createElement('div');
      botNav.className = 'codelab-step-nav';
      if (s > 0) {
        var prevBot = document.createElement('button');
        prevBot.className = 'codelab-nav-btn codelab-prev';
        prevBot.setAttribute('data-target', s - 1);
        prevBot.textContent = 'Back: ' + steps[s - 1].title;
        botNav.appendChild(prevBot);
      }
      if (s < steps.length - 1) {
        var nextBot = document.createElement('button');
        nextBot.className = 'codelab-nav-btn codelab-next';
        nextBot.setAttribute('data-target', s + 1);
        nextBot.textContent = 'Next: ' + steps[s + 1].title;
        botNav.appendChild(nextBot);
      } else {
        var doneBot = document.createElement('a');
        doneBot.className = 'codelab-nav-btn codelab-next';
        doneBot.href = '/labs';
        doneBot.textContent = 'Finish and see all labs';
        botNav.appendChild(doneBot);
      }
      section.appendChild(botNav);

      labContent.appendChild(section);
      sections.push(section);
    }

    var navLinks = nav.querySelectorAll('.codelab-step-link');

    function goToStep(index, scroll) {
      for (var i = 0; i < sections.length; i++) {
        sections[i].classList.toggle('active', i === index);
      }
      for (var j = 0; j < navLinks.length; j++) {
        navLinks[j].classList.toggle('active', j === index);
      }
      history.replaceState(null, '', index === 0 ? location.pathname : '#step-' + (index + 1));
      if (scroll !== false) {
        document.querySelector('.codelab-wrapper').scrollIntoView({ behavior: 'smooth', block: 'start' });
      }
    }

    // Steps are deep-linkable as #step-N (1-based), so a reader can share or reload their place.
    // A heading anchor inside a hidden step (e.g. #some-section) opens that step first.
    function openHash(hash) {
      var stepMatch = /^#step-(\d+)$/.exec(hash);
      if (stepMatch) {
        var index = parseInt(stepMatch[1], 10) - 1;
        if (index >= 0 && index < sections.length) goToStep(index, false);
        return;
      }
      var target = hash.length > 1 && document.getElementById(decodeURIComponent(hash.slice(1)));
      if (!target) return;
      for (var i = 0; i < sections.length; i++) {
        if (sections[i].contains(target)) {
          goToStep(i, false);
          history.replaceState(null, '', hash);
          target.scrollIntoView({ block: 'start' });
          return;
        }
      }
    }
    openHash(location.hash);
    labContent.addEventListener('click', function(e) {
      var link = e.target.closest && e.target.closest('a[href^="#"]');
      if (!link) return;
      e.preventDefault();
      openHash(link.getAttribute('href'));
    });

    for (var i = 0; i < navLinks.length; i++) {
      (function(link) {
        link.addEventListener('click', function() {
          goToStep(parseInt(link.getAttribute('data-step'), 10));
        });
      })(navLinks[i]);
    }

    var btns = document.querySelectorAll('.codelab-nav-btn[data-target]');
    for (var i = 0; i < btns.length; i++) {
      (function(btn) {
        btn.addEventListener('click', function() {
          goToStep(parseInt(btn.getAttribute('data-target'), 10));
        });
      })(btns[i]);
    }

    var images = document.querySelectorAll('.codelab-step-content img');
    images.forEach(function(img) {
      if (img.dataset.zoomable === 'true') return;
      img.dataset.zoomable = 'true';
      img.style.cursor = 'pointer';
      img.addEventListener('click', function() {
        var overlay = document.createElement('div');
        overlay.className = 'zoomable-overlay';
        var enlarged = document.createElement('img');
        enlarged.src = img.src;
        enlarged.alt = img.alt || '';
        overlay.appendChild(enlarged);
        document.body.appendChild(overlay);
        overlay.addEventListener('click', function() { overlay.remove(); });
        document.addEventListener('keydown', function handler(e) {
          if (e.key === 'Escape') { overlay.remove(); document.removeEventListener('keydown', handler); }
        });
      });
    });
  })();
</script>
