---
import BaseLayout from '../layouts/BaseLayout.astro';
import LabCard from '../components/LabCard.astro';
import { getCollection } from 'astro:content';

const mdxLabs = await getCollection('labs', ({ data }) => data.published === true);
const claatLabs = await getCollection('claatLabs', ({ data }) => data.published === true);

const allLabs = [
  ...mdxLabs.map((lab) => ({
    title: lab.data.title,
    date: lab.data.date,
    shortDescription: lab.data.shortDescription,
    categories: lab.data.categories,
    duration: lab.data.duration,
    url: `/lab/${lab.id.replace(/\/index$/, '')}/`,
  })),
  ...claatLabs.map((lab) => ({
    title: lab.data.title,
    date: lab.data.date,
    shortDescription: lab.data.shortDescription,
    categories: lab.data.categories,
    duration: lab.data.duration,
    url: lab.data.url,
  })),
];

allLabs.sort((a, b) => b.date.getTime() - a.date.getTime());
---

<BaseLayout title="Labs" description="Hands-on, step-by-step labs you run on your own machine.">
  <header class="PageHeader">
    <h1>Labs</h1>
    <p>Step-by-step exercises you run on your own machine. Each one builds something, breaks it, and then fixes it properly.</p>
  </header>

  <div class="Year-entries Labs">
    {allLabs.map((lab) => (
      <LabCard
        title={lab.title}
        date={lab.date}
        shortDescription={lab.shortDescription}
        categories={lab.categories}
        url={lab.url}
        duration={lab.duration}
      />
    ))}
  </div>
</BaseLayout>
