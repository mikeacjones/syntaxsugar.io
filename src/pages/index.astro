---
import BaseLayout from '../layouts/BaseLayout.astro';
import PostCard from '../components/PostCard.astro';
import { getCollection } from 'astro:content';
import { postUrl } from '../helpers/format';

const posts = await getCollection('blog', ({ data }) => data.published === true);
posts.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());

const [latest, ...rest] = posts;

// Group the archive by year; the year is the only navigation a list this size needs.
const years = new Map<number, typeof posts>();
for (const post of rest) {
  const year = post.data.date.getUTCFullYear();
  if (!years.has(year)) years.set(year, []);
  years.get(year)!.push(post);
}
---

<BaseLayout>
  {latest && (
    <PostCard
      featured
      title={latest.data.title}
      date={latest.data.date}
      shortDescription={latest.data.shortDescription}
      tags={latest.data.tags}
      url={postUrl(latest.id)}
    />
  )}

  {[...years].map(([year, yearPosts]) => (
    <section class="Year" aria-labelledby={`year-${year}`}>
      <h2 class="Year-label" id={`year-${year}`}>{year}</h2>
      <div class="Year-entries">
        {yearPosts.map((post) => (
          <PostCard
            title={post.data.title}
            date={post.data.date}
            shortDescription={post.data.shortDescription}
            tags={post.data.tags}
            url={postUrl(post.id)}
          />
        ))}
      </div>
    </section>
  ))}
</BaseLayout>
