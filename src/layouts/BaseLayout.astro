---
import Masthead from '../components/Masthead.astro';
import '../styles/global.css';

interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'syntax sugar',
  description = 'Michael Jones writes about durable execution, Temporal, distributed systems, and integration engineering.',
} = Astro.props;

const siteTitle = title === 'syntax sugar' ? 'syntax sugar | Michael Jones' : `${title} | syntax sugar`;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f6f5f9" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#15111c" media="(prefers-color-scheme: dark)" />
    <title>{siteTitle}</title>

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#52307c" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:wght@400;600&family=Source+Serif+4:ital,opsz,wght@0,8..60,400..700;1,8..60,400..700&display=swap"
      rel="stylesheet"
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="SkipLink" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <footer class="SiteFooter">
      <div class="About">
        <img src="/images/profilePicture.png" alt="Michael Jones" width="44" height="44" loading="lazy" />
        <p>Written by Michael Jones, mostly about Temporal and durable execution, with older posts on MuleSoft and DataWeave.</p>
      </div>
      <nav aria-label="Elsewhere">
        <a href="https://github.com/mikeacjones" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/michael-jones-5a870678" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://stackoverflow.com/users/10890536/michael-jones" target="_blank" rel="noreferrer">Stack Overflow</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </nav>
    </footer>
  </body>
</html>
