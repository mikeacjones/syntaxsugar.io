---
import Masthead from '../components/Masthead.astro';
import '../styles/global.css';
import { AUTHOR, SITE_DESCRIPTION, SITE_NAME, markdownUrl } from '../helpers/llm';

interface Props {
  title?: string;
  description?: string;
  // Set for posts and labs: switches Open Graph and JSON-LD to an article.
  article?: { date: Date; tags: string[] };
  // True when the page has a Markdown twin at <page>/index.md.
  hasMarkdown?: boolean;
}

const { title = SITE_NAME, description = SITE_DESCRIPTION, article, hasMarkdown = false } = Astro.props;

const siteTitle = title === SITE_NAME ? `${SITE_NAME} | ${AUTHOR}` : `${title} | ${SITE_NAME}`;
const canonical = new URL(Astro.url.pathname, Astro.site);
const image = new URL('/images/profilePicture.png', Astro.site);
const author = { '@type': 'Person', name: AUTHOR, url: Astro.site, sameAs: ['https://github.com/mikeacjones', 'https://www.linkedin.com/in/michael-jones-5a870678'] };

const jsonLd = article
  ? {
      '@context': 'https://schema.org',
      '@type': 'BlogPosting',
      headline: title,
      description,
      datePublished: article.date.toISOString(),
      keywords: article.tags.join(', '),
      url: canonical,
      mainEntityOfPage: canonical,
      image,
      author,
      publisher: author,
    }
  : {
      '@context': 'https://schema.org',
      '@type': 'WebSite',
      name: SITE_NAME,
      description,
      url: Astro.site,
      author,
    };
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#f7f7fb" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#141414" media="(prefers-color-scheme: dark)" />
    <title>{siteTitle}</title>
    <link rel="canonical" href={canonical} />
    <meta name="author" content={AUTHOR} />

    <!-- Social cards -->
    <meta property="og:site_name" content={SITE_NAME} />
    <meta property="og:type" content={article ? 'article' : 'website'} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:image" content={image} />
    <meta property="og:image:alt" content={AUTHOR} />
    {article && <meta property="article:published_time" content={article.date.toISOString()} />}
    {article && <meta property="article:author" content={AUTHOR} />}
    {article?.tags.map((tag) => <meta property="article:tag" content={tag} />)}
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={image} />

    <!-- Structured data -->
    <script type="application/ld+json" set:html={JSON.stringify(jsonLd)} />

    <!-- Feeds and machine-readable copies -->
    <link rel="alternate" type="application/rss+xml" title={SITE_NAME} href="/rss.xml" />
    <link rel="alternate" type="text/plain" title="llms.txt" href="/llms.txt" />
    {hasMarkdown && <link rel="alternate" type="text/markdown" href={markdownUrl(Astro.url.pathname)} />}

    <!-- Favicons -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/x-icon" href="/favicon.ico" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32x32.png" />
    <link rel="icon" type="image/png" sizes="16x16" href="/favicon-16x16.png" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="mask-icon" href="/safari-pinned-tab.svg" color="#444ce7" />

    <!-- Google Fonts -->
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=JetBrains+Mono:ital,wght@0,100..800;1,100..800&display=swap"
      rel="stylesheet"
    />

    <!-- Sitemap -->
    <link rel="sitemap" href="/sitemap-index.xml" />
  </head>
  <body>
    <a class="SkipLink" href="#main">Skip to content</a>
    <Masthead />
    <main id="main">
      <slot />
    </main>
    <footer class="SiteFooter">
      <div class="About">
        <img src="/images/profilePicture.png" alt="Michael Jones" width="44" height="44" loading="lazy" />
        <p>Written by Michael Jones, mostly about Temporal and durable execution, with older posts on MuleSoft and DataWeave.</p>
      </div>
      <nav aria-label="Elsewhere">
        <a href="https://github.com/mikeacjones" target="_blank" rel="noreferrer">GitHub</a>
        <a href="https://www.linkedin.com/in/michael-jones-5a870678" target="_blank" rel="noreferrer">LinkedIn</a>
        <a href="https://stackoverflow.com/users/10890536/michael-jones" target="_blank" rel="noreferrer">Stack Overflow</a>
        <a href="/rss.xml">RSS</a>
        <a href="/sitemap-index.xml">Sitemap</a>
      </nav>
    </footer>
  </body>
</html>
